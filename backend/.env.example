# Copy to .env for local development.
DJANGO_SETTINGS_MODULE=eia_dcmt.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

DATABASE_URL=postgres://eia:eia@localhost:5432/eia_dcmt

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

# ONA / ODK data source (parity with R TOKEN1 / ONA_TOKEN)
ONA_BASE_URL=https://api.ona.io
ONA_TOKEN=

IPINFO_BASE_URL=https://ipinfo.io

# Auth0 (OIDC) — the ONLY end-user sign-in / registration path.
# Configure an Auth0 "Regular Web Application" and set the callback URL to
#   https://<your-host>/accounts/oidc/auth0/login/callback/
# To expose use-case access, add an `eia_apps` claim to the ID token.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Microsoft Entra ID — OPTIONAL fallback sign-in for CGIAR/IITA staff. Auth0
# stays the primary path; leave these blank to keep Entra off entirely. When set,
# register an Entra app registration with redirect URI
#   https://<your-host>/accounts/oidc/entra/login/callback/
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
